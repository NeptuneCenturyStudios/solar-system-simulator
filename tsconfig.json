{
    "compilerOptions": {
        "target": "es2021",
        "useDefineForClassFields": true,
        "lib": ["ES2021", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        // "moduleResolution": "Node",
        "skipLibCheck": true,
        "allowJs": true,
        "checkJs": false,
        // "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "strict": true,
        "types": ["node"]
    },
    "include": ["src"],
    "references": []
}
